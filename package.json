{
  "name": "anis-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run pricing:validate",
    "dev": "vite",
    "build": "npm run build:app",
    "build:app": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "lint": "eslint .",
    "preview": "vite preview",
    "pricing:validate": "node scripts/generate-interiors-pricing.mjs --validate-only --allow-draft",
    "pricing:generate": "node scripts/generate-interiors-pricing.mjs",
    "pricing:test": "node scripts/test-interiors-pricing.mjs",
    "pricing:web-visibility:test": "node --experimental-strip-types scripts/test-interiors-web-pricing-visibility.mjs",
    "pricing:kitchen-example:test": "node --experimental-strip-types scripts/test-interiors-kitchen-pricing-example.mjs",
    "form:test": "node --experimental-strip-types scripts/test-interiors-inspiration-files.mjs",
    "save": "node scripts/save.mjs"
  },
  "dependencies": {
    "@stripe/stripe-js": "^8.0.0",
    "react-helmet-async": "^3.0.0",
    "@supabase/supabase-js": "^2.86.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.22",
    "i18next": "^25.5.3",
    "lucide-react": "^0.561.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^7.10.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.24",
    "baseline-browser-mapping": "^2.9.4",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass": "^1.93.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  }
}
